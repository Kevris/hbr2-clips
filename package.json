{
  "name": "hbr2-clips",
  "version": "0.6.0",
  "description": "Renderiza clips mp4 de los goles de repeticiones de HaxBall (.hbr2) usando el renderer y los sonidos del propio juego.",
  "keywords": [
    "haxball",
    "hbr2",
    "replay",
    "highlights",
    "video",
    "ffmpeg",
    "node-haxball"
  ],
  "main": "src/index.js",
  "scripts": {
    "extract": "node src/extractGoalClip.js",
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.18",
    "canvas": "^3.2.3",
    "dotenv": "^18.0.2",
    "express": "^4.22.3",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.4.0",
    "node-haxball": "^2.3.1"
  }
}
